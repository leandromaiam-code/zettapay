{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo \"serverless functions auto-detected from /api\"",
  "installCommand": "npm install --include=dev --workspaces=false",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://zettapay-cloud.ajpgd7.easypanel.host/api/v1/:path*"
    },
    {
      "source": "/healthz",
      "destination": "/api/healthz"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/quickstart",
      "destination": "/docs/quickstart.html"
    },
    {
      "source": "/docs/embed",
      "destination": "/docs/embed.html"
    },
    {
      "source": "/docs/webhook",
      "destination": "/docs/webhook.html"
    },
    {
      "source": "/checkout/:invoice_id",
      "destination": "/checkout.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/status/feed.rss",
      "destination": "/api/status/feed.rss"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/docs/api",
      "destination": "/docs/api.html"
    },
    {
      "source": "/install",
      "destination": "/install/index.html"
    },
    {
      "source": "/install/ai",
      "destination": "/install/ai/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/signup",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/launch",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/mainnet",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pay",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/faucet",
      "destination": "/docs",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Powered-By",
          "value": "ZettaPay"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
