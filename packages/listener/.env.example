# @zettapay/listener — variáveis de ambiente (copie para .env)
# NUNCA comite o .env preenchido. O xpub fica SÓ aqui (server-side).

# xpub/zpub BIP-84 da sua carteira (mainnet). Chave PÚBLICA — nunca xprv/zprv.
MERCHANT_XPUB=zpub...

# Endpoint do SEU backend que recebe a confirmação (HMAC assinado).
MERCHANT_WEBHOOK_URL=https://seu-app.com/api/zp/webhook

# Segredo compartilhado para validar a assinatura do webhook no seu backend.
# Gere um valor forte e aleatório (ex: openssl rand -hex 32).
MERCHANT_WEBHOOK_SECRET=troque-por-um-segredo-forte

# Chave de API que o seu backend envia no header X-ZettaPay-Api-Key ao
# chamar POST /invoice. Protege a criação de invoices.
ZETTAPAY_API_KEY=troque-por-uma-chave-forte

# Opcionais
MERCHANT_NETWORK=mainnet
MERCHANT_SHOP_NAME=Minha Loja
MERCHANT_EMAIL=voce@empresa.com
